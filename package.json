{
  "name": "perfectwall",
  "version": "1.0.0",
  "description": "Perfect Wallpaper - A Wallpaper Engine project",
  "main": "index.html",
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.js",
    "build:scss": "sass --style=compressed --no-source-map src/source/scss/main.scss dist/default.css",
    "watch": "tsc --watch",
    "watch:bundle": "node scripts/bundle.js --watch",
    "watch:scss": "sass --watch --style=expanded scss/main.scss dist/default.css",
    "check-types": "tsc --noEmit",
    "bundle": "node scripts/bundle.js",
    "prepare": "yarn run build",
    "build:server:rust": "cd src/server-rs && cargo build --release && powershell -Command \"Copy-Item target/release/perfectwall-server.exe ../../dist/\""
  },
  "author": "etherfun",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.4",
    "license-checker-rseidelsohn": "^4.4.2",
    "sass": "^1.77.8",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "colorthief": "^3.3.1",
    "qweather-icons": "^1.8.0"
  }
}
