<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!-- Pin the .NET Framework 4.8 reference assemblies so MSBuild
         on a clean CI box still finds them. -->
    <add key="globalPackagesFolder" value="packages" />
  </config>
</configuration>
