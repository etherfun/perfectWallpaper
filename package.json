{
  "name": "perfectwall",
  "version": "1.0.0",
  "description": "Perfect Wallpaper - A Wallpaper Engine project",
  "main": "index.html",
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.js",
    "build:scss": "sass --style=compressed --no-source-map src/source/scss/main.scss dist/default.css",
    "watch": "tsc --watch",
    "watch:bundle": "node scripts/bundle.js --watch",
    "watch:scss": "sass --watch --style=expanded scss/main.scss dist/default.css",
    "check-types": "tsc --noEmit",
    "bundle": "node scripts/bundle.js",
    "prepare": "yarn run build",
    "dev:server": "tsc -p src/server",
    "build:server:exe": "tsc -p src/server && pkg src/server/dist/index.js --targets node18-win-x64 --output src/server/dist/server-pkg.exe && create-nodew-exe src/server/dist/server-pkg.exe dist/server.exe",
    "build:server:rust": "cd src/server-rs && cargo build --release && cp target/release/perfectwall-server.exe ../../../dist/",
    "start:server": "yarn run dev:server && node src/server/dist/index.js",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --ui"
  },
  "author": "etherfun",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "create-nodew-exe": "^2.1.0",
    "esbuild": "^0.27.4",
    "license-checker-rseidelsohn": "^4.4.2",
    "pkg": "^5.8.1",
    "sass": "^1.77.8",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "colorthief": "^3.3.1",
    "express": "^4.18.2",
    "music-metadata": "^10.7.2",
    "qweather-icons": "^1.8.0",
    "systeminformation": "^5.22.0"
  }
}
