{
  "name": "perfectwall",
  "version": "1.0.0",
  "description": "Perfect Wallpaper - A Wallpaper Engine project",
  "main": "index.html",
  "scripts": {
    "build": "tsc && node scripts/bundle.js",
    "watch": "tsc --watch",
    "dev": "tsc --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "bundle": "node scripts/bundle.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "wallpaper-engine",
    "typescript",
    "wallpaper"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jquery": "^3.5.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
