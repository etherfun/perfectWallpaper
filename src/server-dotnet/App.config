<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <gcServer enabled="true" />
    <gcConcurrent enabled="true" />
    <!--
      Force every `System.Management` reference (0.0.0.0 —
      9.0.0.0) to resolve to the 4.0.0.0 build that ships with
      .NET Framework 4.8. Without this binding redirect,
      `LibreHardwareMonitorLib 0.9.6` would ask the runtime
      for System.Management 9.0.0.0, which is a .NET 9-only
      assembly and is not on the .NET Framework 4.8 BCL. The
      resulting FileNotFoundException is reported by
      `HardwareMonitorService.InitError`.
    -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Management" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
